}

static void auto_cb(button_data_t *data)
{
    (void)data;

    if (!decoder) {
        return;
    }

    channel_overlay_show("Waiting for Fax");

    stop_wav_test();

    wefax_decoder_set_mode(
        decoder,
        WEFAX_MODE_AUTO
    );

    auto_fax_confirmed_seen = false;
    clear_preview();

    printf(
